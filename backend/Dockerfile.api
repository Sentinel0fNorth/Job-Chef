FROM gradle:9.8.2-jdk25 AS build
WORKDIR /workspace
COPY . .
RUN gradle --no-daemon :api:bootJar

FROM eclipse-temurin:25-jre
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system jobchef \
    && useradd --system --gid jobchef --home-dir /app --no-create-home jobchef \
    && mkdir -p /app /var/lib/jobchef/artifacts \
    && chown -R jobchef:jobchef /app /var/lib/jobchef
WORKDIR /app
COPY --from=build /workspace/api/build/libs/api-1.0.0.jar /app/app.jar
RUN chown jobchef:jobchef /app/app.jar
USER jobchef:jobchef
ENV JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=70"
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
